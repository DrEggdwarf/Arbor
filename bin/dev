#!/usr/bin/env bash

# Ensure rbenv shims take priority, then user gem bin for executables like foreman
export PATH="$HOME/.rbenv/shims:$HOME/.local/share/gem/ruby/$(ruby -e 'puts RUBY_VERSION[/\d+\.\d+/]').0/bin:$PATH"

if ! command -v foreman &> /dev/null; then
  echo "Installing foreman..."
  gem install foreman --no-document
fi

# Free ports if already in use
fuser -k 3000/tcp 2>/dev/null || true
fuser -k 3036/tcp 2>/dev/null || true

exec foreman start -f Procfile.dev "$@"
